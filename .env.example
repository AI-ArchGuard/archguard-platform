# Non-secret local overrides. Copy to .env only if your shell or launcher loads it.
SERVER_PORT=8080
ARCHGUARD_SHUTDOWN_TIMEOUT=20s
ARCHGUARD_DB_URL=jdbc:postgresql://127.0.0.1:5432/archguard
ARCHGUARD_DB_USERNAME=
ARCHGUARD_DB_PASSWORD=
ARCHGUARD_DB_POOL_MAX_SIZE=10
ARCHGUARD_DB_POOL_MIN_IDLE=1
# Required only when the oidc profile is active. Do not commit real tenant values or tokens.
ARCHGUARD_OIDC_ISSUER_URI=
ARCHGUARD_OIDC_AUDIENCE=
# Optional: avoids discovery at startup while issuer validation remains enabled.
ARCHGUARD_OIDC_JWK_SET_URI=
ARCHGUARD_OIDC_ALLOW_HTTP=false
ARCHGUARD_SOURCE_ROOT=./sources
ARCHGUARD_SCANNER_JAR=/opt/archguard/scanner.jar
ARCHGUARD_SCANNER_VALIDATION_TIMEOUT=10s
ARCHGUARD_RUNNER_MAILBOX=./runner-mailbox
ARCHGUARD_RUNNER_LEASE=5m
ARCHGUARD_RUNNER_MAX_ATTEMPTS=2

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archguard.dev/contracts/agent-personal-daily-grant-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "riskAcknowledgementId",
    "runtimeBindingDigest",
    "allowedPurposes",
    "maxAttempts",
    "maxCostMicrousd",
    "expiresAt",
    "callsApproved"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "riskAcknowledgementId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "runtimeBindingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowedPurposes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "FINDING_EXPLANATION",
          "PR_SUMMARY"
        ]
      }
    },
    "maxAttempts": {
      "type": "integer",
      "format": "int32",
      "minimum": 1,
      "maximum": 2147483647
    },
    "maxCostMicrousd": {
      "type": "integer",
      "format": "int64",
      "minimum": 316373,
      "maximum": 751619276450000
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "callsApproved": {
      "type": "boolean",
      "const": true
    }
  },
  "description": "Structural bounds only. Service and database must additionally enforce maxCostMicrousd <= maxAttempts * 350000 using long arithmetic, current owner/Project/binding, cumulative usage and approved expiry. No default counts, money or expiry; fixture values are synthetic, not spending approval."
}

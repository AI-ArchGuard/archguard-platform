{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archguard.dev/contracts/agent-personal-daily-request-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grantId",
    "selectedMaterialConfirmed",
    "selection"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "grantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "selectedMaterialConfirmed": {
      "type": "boolean",
      "const": true
    },
    "selection": {
      "$ref": "#/$defs/Selection"
    }
  },
  "$defs": {
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "scanJobId",
        "reportSha256",
        "prHeadRevisionId",
        "findingIds",
        "documentVersionIds"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "FINDING_EXPLANATION",
            "PR_SUMMARY"
          ]
        },
        "scanJobId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "reportSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prHeadRevisionId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "findingIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "documentVersionIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "FINDING_EXPLANATION"
              }
            }
          },
          "then": {
            "properties": {
              "prHeadRevisionId": {
                "type": "null"
              },
              "findingIds": {
                "maxItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "prHeadRevisionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          }
        }
      ]
    }
  }
}

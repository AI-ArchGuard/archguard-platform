{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archguard.dev/contracts/agent-personal-daily-risk-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeBindingDigest",
    "expiresAt",
    "sourcesReviewed",
    "riskAccepted",
    "materialRightsAccepted"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "runtimeBindingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "sourcesReviewed": {
      "type": "boolean",
      "const": true
    },
    "riskAccepted": {
      "type": "boolean",
      "const": true
    },
    "materialRightsAccepted": {
      "type": "boolean",
      "const": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archguard.example/contracts/agent-personal-enablement-0.2.0.schema.json",
  "title": "Personal acknowledgement input; not a live-call or batch authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "accountRef", "deploymentRef", "expiresAt", "sources", "unknowns", "riskAccepted", "modelAlias", "mappingSnapshot", "allowedResponseModels", "priceCatalogVersion", "priceCatalogExpiresAt", "secretCheckRef", "networkCheckRef", "dataScope", "revocationConditions", "credentialVersion"],
  "properties": {
    "schemaVersion": {"const": "0.2.0"},
    "scope": {"const": "PERSONAL"},
    "accountRef": {"$ref": "#/$defs/Reference"},
    "deploymentRef": {"$ref": "#/$defs/Reference"},
    "expiresAt": {"type": "string", "format": "date-time", "description": "Server requires now < expiry <= now + 7 days and expiry <= price expiry."},
    "sources": {"type": "array", "minItems": 4, "maxItems": 5, "items": {"$ref": "#/$defs/Source"}, "description": "Unique kinds; TERMS, PRIVACY, CACHE and MODEL_PRICE required. checkedAt within the past 7 days. Server validates exact kind/URL pairs without fetching."},
    "unknowns": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["PROCESSING_REGION", "STORAGE_REGION", "TRAINING", "HUMAN_REVIEW", "LOG_RETENTION", "CACHE_ISOLATION", "CACHE_RETENTION", "SUBPROCESSORS"]}},
    "riskAccepted": {"const": true},
    "modelAlias": {"const": "deepseek-flash"},
    "mappingSnapshot": {"const": "deepseek-v4.1-flash-2026-10-06"},
    "allowedResponseModels": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "deepseek-flash"}},
    "priceCatalogVersion": {"const": "deepseek-flash-peak-usd-2026-10-06"},
    "priceCatalogExpiresAt": {"type": "string", "format": "date-time", "description": "Server requires now < expiry <= now + 7 days."},
    "secretCheckRef": {"$ref": "#/$defs/Reference"},
    "networkCheckRef": {"$ref": "#/$defs/Reference"},
    "dataScope": {"const": "SYNTHETIC_ACCEPTANCE"},
    "revocationConditions": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["OWNER_REVOKED", "SCOPE_CHANGED", "POLICY_CHANGED", "MODEL_CHANGED", "PRICE_CHANGED", "SECRET_CHECK_INVALID", "NETWORK_CHECK_INVALID"]}},
    "credentialVersion": {"type": "string", "format": "uuid", "description": "Must match the current valid encrypted credential metadata; never contains Key material."}
  },
  "$defs": {
    "Reference": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!sk-)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "description": "Non-sensitive opaque index only; never a supplier account ID, path or secret."},
    "Source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "url", "version", "checkedAt"],
      "properties": {
        "kind": {"enum": ["TERMS", "PRIVACY", "CACHE", "MODEL_PRICE", "PROTOCOL"]},
        "url": {"enum": ["https://cdn.deepseek.com/policies/zh-CN/deepseek-open-platform-terms-of-service.html", "https://cdn.deepseek.com/policies/en-US/deepseek-privacy-policy.html", "https://api-docs.deepseek.com/guides/kv_cache/", "https://api-docs.deepseek.com/quick_start/pricing/", "https://api-docs.deepseek.com/guides/responses_api/"]},
        "version": {"$ref": "#/$defs/Reference"},
        "checkedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {"title": "ArchGuard Personal DeepSeek credential management", "version": "0.1.0", "description": "ADR-0013 single deployment slot, configured owner only. Default off; local-compose loopback deployment only. No readback, model call or automatic enablement. All responses including errors use Cache-Control: no-store."},
  "security": [{"platformIdentity": []}],
  "paths": {
    "/api/v1/agent/credentials/deepseek": {
      "get": {
        "operationId": "getDeepSeekCredentialStatus",
        "description": "Metadata only. Authenticated configured owner required; missing master or corrupt ciphertext fails closed. Origin, when present, must match the configured loopback UI origin.",
        "responses": {"200": {"$ref": "#/components/responses/Status"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      },
      "put": {
        "operationId": "writeDeepSeekCredential",
        "description": "Write/replace with a new version; no automatic retry. Origin must exactly match configured UI origin. <=512 raw JSON bytes, no duplicate/trailing/unknown fields. No validity/balance check; never log or persist browser input.",
        "parameters": [{"$ref": "#/components/parameters/Origin"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WriteCredentialRequest"}}}},
        "responses": {"200": {"$ref": "#/components/responses/Status"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "415": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      },
      "delete": {
        "operationId": "deleteDeepSeekCredential",
        "description": "Remove local encrypted slot; absent is idempotent. Does not revoke provider Key or erase snapshots/in-flight requests. No fallback to other credentials. Corrupt slot/wrong master preserved with 503. Existing results/audit retained.",
        "parameters": [{"$ref": "#/components/parameters/Origin"}],
        "responses": {"200": {"$ref": "#/components/responses/Status"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"platformIdentity": {"type": "http", "scheme": "bearer"}},
    "parameters": {"Origin": {"name": "Origin", "in": "header", "required": true, "description": "Browser supplies this header. No cross-origin API access; public origins not permitted.", "schema": {"type": "string"}}},
    "responses": {
      "Status": {"description": "Metadata only; no Key/suffix/fingerprint. An audit failure after mutation may require manual status refresh; never auto-retry writes.", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CredentialStatus"}}}},
      "Error": {"description": "Stable error/traceId, never input/rejectedValue/provider response/paths.", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
    },
    "schemas": {
      "WriteCredentialRequest": {"type": "object", "additionalProperties": false, "required": ["apiKey"], "properties": {"apiKey": {"type": "string", "writeOnly": true, "minLength": 16, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]{16,256}$"}}},
      "CredentialStatus": {"type": "object", "additionalProperties": false, "required": ["configured", "credentialVersion", "updatedAt"], "properties": {"configured": {"type": "boolean"}, "credentialVersion": {"type": ["string", "null"], "format": "uuid"}, "updatedAt": {"type": ["string", "null"], "format": "date-time"}}},
      "ApiError": {"type": "object", "required": ["code", "message", "traceId", "details"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "traceId": {"type": "string"}, "details": {"type": "object", "additionalProperties": true}}}
    }
  }
}

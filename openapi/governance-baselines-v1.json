{
  "openapi": "3.1.0",
  "info": {
    "title": "ArchGuard governance baseline API",
    "version": "0.1.0",
    "description": "Stage 3C runtime API. Report submission and quality gates in governance-v1.json remain contract-only until later slices."
  },
  "x-archguard-lifecycle": "runtime-3c",
  "security": [{"platformIdentity": []}],
  "paths": {
    "/api/v1/projects/{projectId}/repositories/{repositoryId}/baselines": {
      "post": {
        "operationId": "promoteBaseline",
        "summary": "Promote a successful scan to an immutable baseline version, or reselect its existing version",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RepositoryId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PromoteRequest"}}}},
        "responses": {"201": {"description": "Baseline version selected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BaselineVersion"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/InvalidReport"}}
      },
      "get": {
        "operationId": "listBaselineVersions",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RepositoryId"}, {"$ref": "#/components/parameters/TargetBranch"}, {"$ref": "#/components/parameters/RuleSetVersionId"}],
        "responses": {"200": {"description": "Versions, newest first", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/BaselineVersion"}}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/api/v1/projects/{projectId}/repositories/{repositoryId}/baselines/active": {
      "get": {
        "operationId": "getActiveBaseline",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RepositoryId"}, {"$ref": "#/components/parameters/TargetBranch"}, {"$ref": "#/components/parameters/RuleSetVersionId"}],
        "responses": {"200": {"description": "Currently selected immutable version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BaselineVersion"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/api/v1/projects/{projectId}/repositories/{repositoryId}/baselines/{baselineVersionId}/select": {
      "post": {
        "operationId": "selectBaselineVersion",
        "summary": "Append an audited selection without modifying any baseline version",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RepositoryId"}, {"$ref": "#/components/parameters/BaselineVersionId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScopeRequest"}}}},
        "responses": {"200": {"description": "Selected version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BaselineVersion"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/api/v1/projects/{projectId}/repositories/{repositoryId}/comparisons": {
      "post": {
        "operationId": "compareWithActiveBaseline",
        "summary": "Persist deterministic NEW, EXISTING and RESOLVED Finding sets",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RepositoryId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompareRequest"}}}},
        "responses": {"200": {"description": "Immutable comparison; identical inputs return the same ID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Comparison"}}}}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/InvalidReport"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"platformIdentity": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {
      "ProjectId": {"name": "projectId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "RepositoryId": {"name": "repositoryId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "BaselineVersionId": {"name": "baselineVersionId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "TargetBranch": {"name": "targetBranch", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 255}},
      "RuleSetVersionId": {"name": "ruleSetVersionId", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "responses": {
      "BadRequest": {"description": "Invalid request metadata"},
      "NotFound": {"description": "Resource absent or not visible in this Project"},
      "Conflict": {"description": "Scan or baseline state is incompatible"},
      "InvalidReport": {"description": "Report cannot yield a supported stable Finding identity"}
    },
    "schemas": {
      "ScopeRequest": {"type": "object", "required": ["targetBranch", "ruleSetVersionId"], "properties": {"targetBranch": {"type": "string"}, "ruleSetVersionId": {"type": "string", "format": "uuid"}}},
      "PromoteRequest": {"allOf": [{"$ref": "#/components/schemas/ScopeRequest"}, {"type": "object", "required": ["scanJobId", "commitSha"], "properties": {"scanJobId": {"type": "string", "format": "uuid"}, "commitSha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}}]},
      "CompareRequest": {"allOf": [{"$ref": "#/components/schemas/ScopeRequest"}, {"type": "object", "required": ["candidateJobId"], "properties": {"candidateJobId": {"type": "string", "format": "uuid"}}}]},
      "BaselineVersion": {"type": "object", "required": ["id", "projectId", "repositoryId", "targetBranch", "ruleSetVersionId", "version", "scanJobId", "commitSha", "reportSha256", "fingerprintVersion", "createdBy", "createdAt", "active", "selectionVersion"], "properties": {"id": {"type": "string", "format": "uuid"}, "projectId": {"type": "string", "format": "uuid"}, "repositoryId": {"type": "string", "format": "uuid"}, "targetBranch": {"type": "string"}, "ruleSetVersionId": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 1}, "scanJobId": {"type": "string", "format": "uuid"}, "commitSha": {"type": "string"}, "reportSha256": {"type": "string"}, "fingerprintVersion": {"type": "string", "const": "platform-finding-v1"}, "createdBy": {"type": "string", "format": "uuid"}, "createdAt": {"type": "string", "format": "date-time"}, "active": {"type": "boolean"}, "selectionVersion": {"type": "integer", "minimum": 0}}},
      "ClassifiedFinding": {"type": "object", "required": ["classification", "fingerprint", "payloadSha256", "ruleId", "ruleVersion", "severity", "scannerFindingId"], "properties": {"classification": {"type": "string", "enum": ["NEW", "EXISTING", "RESOLVED"]}, "fingerprint": {"type": "string"}, "payloadSha256": {"type": "string"}, "ruleId": {"type": "string"}, "ruleVersion": {"type": "string"}, "severity": {"type": "string"}, "scannerFindingId": {"type": "string"}}},
      "Comparison": {"type": "object", "required": ["id", "baselineVersionId", "candidateJobId", "candidateReportSha256", "fingerprintVersion", "createdAt", "findings", "newCount", "existingCount", "resolvedCount"], "properties": {"id": {"type": "string", "format": "uuid"}, "baselineVersionId": {"type": "string", "format": "uuid"}, "candidateJobId": {"type": "string", "format": "uuid"}, "candidateReportSha256": {"type": "string"}, "fingerprintVersion": {"type": "string", "const": "platform-finding-v1"}, "createdAt": {"type": "string", "format": "date-time"}, "findings": {"type": "array", "items": {"$ref": "#/components/schemas/ClassifiedFinding"}}, "newCount": {"type": "integer"}, "existingCount": {"type": "integer"}, "resolvedCount": {"type": "integer"}}}
    }
  }
}
